# Secrets — never commit
.env
.env.*
!*.env.template
facility_credentials.txt
*.secret

# Database & backups
*.sqlite3
*.sqlite3-*
backups/

# Logs
logs/
*.log

# Media (uploaded PHI-adjacent files)
media/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Django static build
staticfiles/

# Desktop client build artifacts
desktop/build/
desktop/dist/
desktop_client/build/
desktop_client/dist/
desktop_client/*.toc
desktop_client/*.pkg

# Temp/diagnostic scripts (one-off probes, not source)
_check*.py
_diag*.py
_fix*.py
_patch*.py
_probe*.py
_dryrun*.py
_tmp/