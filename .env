DJANGO_SECRET_KEY=5cp%8yr3q3rkqp_43vd*caouw(9m6&t9&)gqi!je7=y@8#ef(w
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Database: settings.py reads DB_ENGINE/DB_NAME (DATABASE_URL is not read).
# Defaults to the bundled SQLite file (db.sqlite3).
STATIC_URL=/static/
MEDIA_URL=/media/
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Configure this lab's own SMTP credentials before enabling SMTP delivery.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Console backend until real SMTP credentials are configured for this lab.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Friday AI Assistant
FRIDAY_ENABLED=True
# DeepSeek (OpenAI-compatible chat-completions API). Paste this lab's key below.
#   Sign up at https://platform.deepseek.com -> "API keys" -> create key (sk-...).
# Leave FRIDAY_API_KEY empty to run Friday in offline mode (no external calls).
FRIDAY_API_KEY=
FRIDAY_MODEL=deepseek-chat
FRIDAY_LLM_BASE_URL=https://api.deepseek.com/v1
# Groq alternative (just swap the three lines above):
#   FRIDAY_API_KEY=gsk_...
#   FRIDAY_MODEL=openai/gpt-oss-120b
#   FRIDAY_LLM_BASE_URL=https://api.groq.com/openai/v1
FRIDAY_REQUIRE_CONFIRMATION=True
FRIDAY_AVAILABLE_FOR_ROLES=superuser,administrator,accountant,pathologist,technician,lab_manager,staff

# Friday AI Assistant (continued)
FRIDAY_LLM_TIMEOUT=20
FRIDAY_MAX_CONTEXT_LENGTH=8000
FRIDAY_LOG_ALL_INTERACTIONS=True
FRIDAY_RATE_LIMIT_PER_MINUTE=30
FRIDAY_CONVERSATION_TTL_DAYS=30
FRIDAY_ACTION_TTL_MINUTES=10
# PHI safety: set True only if you accept sending masked-real PHI to your LLM provider
FRIDAY_LLM_SEND_PHI=False
# Roles allowed to perform mutating actions and register cases via Friday
FRIDAY_WRITE_ACCESS_ROLES=superuser,administrator,pathologist
FRIDAY_CREATE_CASE_ROLES=administrator,pathologist,technician
# Comma list of LLM tool names to allow (empty = all)
FRIDAY_LLM_TOOLS=

# Localhost-only development defaults (no external domain configured).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
